```{r}

library(tidyverse)

# Function to read and compute Ho
compute_Ho <- function(het_file, label){
  df <- read.table(het_file, header = TRUE)
  df <- df %>%
    mutate(Ho = (N_SITES - O.HOM.) / N_SITES,
           Filter = label)
  return(df)
}

# Load all four
V_noScaff   <- compute_Ho("Virginia_noScaff_mohncalc.het",   "MyFiltering")
C_noScaff   <- compute_Ho("Canada_noScaff_mohncalc.het",     "MyFiltering")


# Combine
Virginia <- bind_rows(V_noScaff,) %>% mutate(State = "Virginia")
Canada   <- bind_rows(C_noScaff,) %>% mutate(State = "Canada")

                      
All_Ho <- bind_rows(Virginia, Canada)

All_Ho %>%
  group_by(State,) %>%
  summarise(
    mean_Ho = mean(Ho),
    sd_Ho   = sd(Ho),
    min_Ho  = min(Ho),
    max_Ho  = max(Ho),
    n       = n()
  )

```

Visualize

```{r}
All_Ho$State  <- factor(All_Ho$State,  levels = c("Virginia", "Canada"))


het_p4 <- ggplot(All_Ho, aes(x = State, y = Ho * 100)) +
  geom_boxplot(aes(fill = State), alpha = 0.8, outlier.shape = NA) +
  geom_jitter(color = "black",
              width = 0.15,
              size = 1.2,
              alpha = 0.7) +
  scale_fill_manual(values = c("Virginia" = "purple",
                               "Canada"   = "red")) +
  theme_light(base_size = 14) +
  labs(
    x = "Reference Genome",
    y = "Percent Heterozygous SNPs (%)",
    title = "Observed Heterozygosity by Reference"
  ) +
  theme(
    plot.title = element_text(size = 16, face = "bold"),
    legend.position = "none"   # remove legend since colors match states
  )

# Save to PDF
ggsave("Het_plot_mohn_rep4.pdf", plot = het_p4, width = 6, height = 5)

