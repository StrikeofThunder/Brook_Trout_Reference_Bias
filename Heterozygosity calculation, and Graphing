By chromosome

```{r}

library(dplyr)
library(readr)
library(stringr)
library(purrr)

# 1. Load chromosome map
chrom_map <- read_csv("chrom_map.csv")

# 2. Load Virginia het files
virg_files <- list.files("Virginia_mohn_again", pattern = "Virginia_.*het$", full.names = TRUE)

virg_df <- map_df(virg_files, function(f) {
  df <- read_table(f, comment = "#")
  df$Chrom <- str_extract(basename(f), "Sfo_[0-9]+")
  df$State <- "Virginia"
  df
})

# 3. Load Canada het files
can_files <- list.files("Canada_mohn_again", pattern = "Canada_.*het$", full.names = TRUE)

can_df <- map_df(can_files, function(f) {
  df <- read_table(f, comment = "#")
  df$Chrom <- str_extract(basename(f), "NC_[0-9]+\\.[0-9]+")
  df$State <- "Canada"
  df
})


# Join Virginia and Canada to the map
virg_df2 <- virg_df %>% left_join(chrom_map, by = c("Chrom" = "Virginia"))
can_df2  <- can_df  %>% left_join(chrom_map, by = c("Chrom" = "Canada"))

# Combine into one tidy table
All_Ho <- bind_rows(virg_df2, can_df2)

#build table of Ho values
Ho_table <- Chrom_Ho %>%
  select(TrueN, State, Ho) %>%
  group_by(TrueN, State) %>%
  summarise(Mean_Ho = mean(Ho, na.rm = TRUE), .groups = "drop") %>%
  tidyr::pivot_wider(names_from = TrueN, values_from = Mean_Ho) %>%
  arrange(State)

write_csv(Ho_table, "Ho_by_chromosome.csv")
```

